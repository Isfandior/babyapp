rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(fid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
    }

    // Pairing codes: anyone signed in can look one up by its exact code, never list them.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn();
    }

    match /families/{fid} {
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow read, update: if signedIn() && request.auth.uid in resource.data.members;
      // Joining with a code: the only change allowed is adding yourself to members.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members;

      match /{sub=**} {
        allow read, write: if isMember(fid);
      }
    }
  }
}
